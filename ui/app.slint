import { ListView, Button } from "std-widgets.slint";

struct Entry {
    text: string,
    pinned: bool,
}

// 自绘标题栏：拖动移动窗口 + 置顶/隐藏/关闭
component TitleBar inherits Rectangle {
    height: 38px;
    background: #2b2b2b;

    in property <bool> topmost;

    callback hide-clicked();
    callback close-clicked();
    callback toggle-pin-clicked();
    callback drag-begin(x: length, y: length);
    callback drag-move(x: length, y: length);
    callback drag-end();

    private property <length> last-x: 0px;
    private property <length> last-y: 0px;

    // 拖动层：铺满整条标题栏，按钮绘制在其上层所以不受影响
    // 采用“锚定法”拖动：按下时上报鼠标起点，移动时上报绝对坐标，
    // Rust 侧用「窗口起点 + (当前鼠标 - 鼠标起点)」推导位置，保证跟手不漂移
    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                drag-begin(self.mouse-x, self.mouse-y);
            } else if e.kind == PointerEventKind.up {
                drag-end();
            }
        }
        moved => {
            drag-move(self.mouse-x, self.mouse-y);
        }
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;

        Text {
            text: "剪贴板工具";
            color: #eee;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
        Rectangle { }

        Button {
            text: topmost ? "取消置顶" : "置顶";
            clicked => { toggle-pin-clicked(); }
        }
        Button {
            text: "最小化";
            clicked => { hide-clicked(); }
        }
        Button {
            text: "×";
            clicked => { close-clicked(); }
        }
    }
}

export component AppWindow inherits Window {
    no-frame: true;
    title: "剪贴板工具";
    width: 480px;
    height: 640px;
    always-on-top: root.topmost;

    in property <[Entry]> clipboard-items: [];
    in property <string> status-text: "0 条记录";
    in property <bool> topmost: false;

    callback refresh-clicked();
    callback clear-clicked();
    callback entry-clicked(int);
    callback entry-pin-clicked(int);
    callback entry-delete-clicked(int);
    callback hide-window();
    callback close-window();
    callback toggle-pin();
    callback drag-begin(x: length, y: length);
    callback drag-move(x: length, y: length);
    callback drag-end();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // 顶部：自绘标题栏
        TitleBar {
            topmost: root.topmost;
            hide-clicked => { root.hide-window(); }
            close-clicked => { root.close-window(); }
            toggle-pin-clicked => { root.toggle-pin(); }
            drag-begin(x, y) => { root.drag-begin(x, y); }
            drag-move(x, y) => { root.drag-move(x, y); }
            drag-end() => { root.drag-end(); }
        }

        // 内容区
        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            // 状态行
            HorizontalLayout {
                Text {
                    text: "剪贴板历史";
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { }
                Text {
                    text: status-text;
                    color: #888;
                    vertical-alignment: center;
                }
            }

            Rectangle { height: 1px; background: #ddd; }

            // 空状态提示（有数据时自动隐藏）
            Text {
                visible: clipboard-items.length == 0;
                text: "剪贴板为空 —— 复制点内容试试，会自动出现在这里";
                wrap: word-wrap;
                color: #aaa;
            }

            // 中部：剪贴板条目列表
            // 每行 = 主内容（点击复制）+ 置顶按钮 + 删除按钮
            ListView {
                for item[index] in clipboard-items: HorizontalLayout {
                    spacing: 6px;

                    // 主内容区：置顶条目黄色高亮
                    Rectangle {
                        border-radius: 6px;
                        background: item.pinned ? #fff3cd : #f5f5f5;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { entry-clicked(index); }
                            HorizontalLayout {
                                padding: 8px;
                                Text {
                                    text: item.text;
                                    wrap: word-wrap;
                                    color: #222;
                                }
                            }
                        }
                    }

                    // 置顶 / 取消置顶
                    Button {
                        text: item.pinned ? "取消置顶" : "置顶";
                        clicked => { entry-pin-clicked(index); }
                    }

                    // 删除单条
                    Button {
                        text: "删除";
                        clicked => { entry-delete-clicked(index); }
                    }
                }
            }

            // 底部：操作按钮
            HorizontalLayout {
                alignment: end;
                Button {
                    text: "清空";
                    clicked => { clear-clicked(); }
                }
                Button {
                    text: "刷新";
                    clicked => { refresh-clicked(); }
                }
            }
        }
    }
}